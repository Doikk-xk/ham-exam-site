# 复制为 .env 后按需修改：cp .env.example .env

# 宿主机映射端口
HAM_PORT=8080

# 管理员账号（首次启动时创建；登录后请立即在「设置」里改密码）
HAM_ADMIN_USER=admin
HAM_ADMIN_PASS=admin

# 注册激活码种子：仅首次启动、激活码表为空时写入，之后在管理员面板管理
HAM_REGISTER_CODE=业余无线电

# 容器内时区
TZ=Asia/Shanghai

# 构建使用的基础镜像。国内网络拉不到 Docker Hub 时，改用加速源，例如：
#   BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# BASE_IMAGE=python:3.12-slim

# 会话加密密钥。留空则容器首次启动时自动生成并存到数据卷（推荐，无需配置）。
# 手动指定时请填一段足够长的随机字符串，且不要提交到版本库。
# HAM_SECRET_KEY=
